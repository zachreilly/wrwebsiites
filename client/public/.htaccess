Options -Indexes
RewriteEngine On

# Always use HTTPS and the bare domain (wrwebsites.com, no www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://wrwebsites.com/$1 [L,R=301]

# Old pages that no longer exist go to the right place
RewriteRule ^(payment|direct-payment|payment-setup)/?$ /onboarding [L,R=302]
RewriteRule ^(admin|customer)(/.*)?$ / [L,R=302]

# Real files and folders are served as normal
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a page in the app
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Built scripts and styles have unique names, so they can be cached for a long time
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The page itself should always be checked for updates
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
